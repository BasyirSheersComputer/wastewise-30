version: '3.8'

services:
  wastewise-frontend:
    image: basyir/wastewise-30-frontend:latest
    container_name: wastewise-frontend
    restart: always
    ports:
      # Map the container port 8080 to the host's localhost port 8080,
      # as expected by your Nginx config.
      - "127.0.0.1:8080:8080"
    environment:
      # These variables must be passed by Jenkins to the host, or be present in a .env file
      - VITE_SUPABASE_URL=${VITE_SUPABASE_URL}
      - VITE_SUPABASE_ANON_KEY=${VITE_SUPABASE_ANON_KEY}
      - VITE_STRIPE_PUBLISHABLE_KEY=${VITE_STRIPE_PUBLISHABLE_KEY}
      - VITE_FRONTEND_URL=https://sheerstechnologies.com/wastewise-30
      # The frontend now talks to the backend using its service name "wastewise-backend"
      - VITE_BACKEND_URL=http://wastewise-backend:3000
    depends_on:
      - wastewise-backend

  wastewise-backend:
    image: basyir/wastewise-30-backend:latest
    container_name: wastewise-backend
    restart: always
    ports:
      # Map the container port 3000 to the host's localhost port 3000,
      # as expected by your Nginx config.
      - "127.0.0.1:3000:3000"
    environment:
      # These variables must be passed by Jenkins to the host, or be present in a .env file
      - STRIPE_SECRET_KEY=${STRIPE_SECRET_KEY}
      - STRIPE_PUBLISHABLE_KEY=${STRIPE_PUBLISHABLE_KEY}
      - OPENAI_API_KEY=${OPENAI_API_KEY}
      - JWT_SECRET=${JWT_SECRET}
      - SMTP_USER=${SMTP_USER}
      - SMTP_PASS=${SMTP_PASS}
      - TWILIO_ACCOUNT_SID=${TWILIO_ACCOUNT_SID}
      - TWILIO_AUTH_TOKEN=${TWILIO_AUTH_TOKEN}
      - TWILIO_PHONE_NUMBER=${TWILIO_PHONE_NUMBER}
      - DATABASE_URL=${DATABASE_URL}
      - CORS_ORIGIN=https://sheerstechnologies.com
