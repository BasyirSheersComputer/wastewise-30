# Supabase Configuration
VITE_SUPABASE_URL=https://your-project-url.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Stripe Configuration
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
VITE_STRIPE_PRICING_TABLE_ID=prctbl_your_pricing_table_id

# API Configuration
VITE_API_BASE_URL=http://localhost:3001

# Trial Configuration
VITE_TRIAL_PERIOD_DAYS=30

# Note: These values will be overridden by Cloud Build secrets in production
# For local development, copy this file to frontend/.env and fill in your actual values
