# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Build outputs
dist/
build/
.next/
out/

# Environment files - Allow specific ones for build but exclude sensitive ones
.env.local
.env.development.local
.env.test.local
.env.production.local
# Allow environment files that are needed for build
!frontend/.env
!frontend/.env.production
!backend/.env
!config/environment/

# IDE files
.vscode/
.idea/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db

# Git
.git/
.gitignore

# Documentation
docs/
*.md
!README.md

# Scripts and configs (keep only what's needed for build)
scripts/
config/jenkins/

# Test files
**/*.test.js
**/*.test.ts
**/*.spec.js
**/*.spec.ts
coverage/

# Logs
logs/
*.log

# Temporary files
tmp/
temp/

# Database files
*.sqlite
*.db

# Backup files
*.bak
*.backup
