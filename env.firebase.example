# Firebase Environment Variables Example
# Copy this file to .env.firebase and fill in your actual values

# Firebase Configuration
FIREBASE_PROJECT_ID=wastewise-30
FIREBASE_API_KEY=your_firebase_api_key_here
FIREBASE_AUTH_DOMAIN=wastewise-30.firebaseapp.com
FIREBASE_STORAGE_BUCKET=wastewise-30.appspot.com
FIREBASE_MESSAGING_SENDER_ID=your_sender_id_here
FIREBASE_APP_ID=your_app_id_here

# Supabase Configuration (if still using Supabase)
SUPABASE_URL=your_supabase_url_here
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# AI Services
OPENAI_API_KEY=your_openai_api_key_here
GOOGLE_GENAI_API_KEY=your_google_genai_api_key_here

# Payment Processing
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Authentication
JWT_SECRET=your_jwt_secret_here

# Environment
NODE_ENV=production

# Trial Configuration
TRIAL_PERIOD_DAYS=30
VITE_TRIAL_PERIOD_DAYS=30

# API Configuration
API_BASE_URL=https://us-central1-wastewise-30.cloudfunctions.net/api

# Database Configuration (if using Firestore)
FIRESTORE_EMULATOR_HOST=localhost:8080

# Storage Configuration
FIREBASE_STORAGE_EMULATOR_HOST=localhost:9199

# Functions Configuration
FUNCTIONS_EMULATOR_HOST=localhost:5001

# Hosting Configuration
HOSTING_EMULATOR_HOST=localhost:5000

# Authentication Emulator
FIREBASE_AUTH_EMULATOR_HOST=localhost:9099
