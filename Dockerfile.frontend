# Stage 1: Build the Vite application
FROM node:18-alpine AS builder

# Set the working directory to the root of the app
WORKDIR /app

# Copy package.json and package-lock.json from the frontend subdirectory
COPY ./frontend/package*.json ./frontend/

# Install dependencies in the frontend subdirectory
WORKDIR /app/frontend
RUN npm install

# Copy the rest of the application source code from the frontend subdirectory
COPY ./frontend .

# Build the application for production
RUN npm run build


# Stage 2: Serve the application with Nginx
FROM nginx:1.23-alpine

# Remove the default Nginx configuration file
RUN rm -f /etc/nginx/conf.d/default.conf

# Copy our custom Nginx configuration file from the frontend subdirectory
COPY ./frontend/nginx.conf /etc/nginx/conf.d/default.conf

# Copy the built application from the builder stage
COPY --from=builder /app/frontend/dist /usr/share/nginx/html

# The Nginx container will expose port 80 by default.
EXPOSE 80

# Command to run Nginx when the container starts
CMD ["nginx", "-g", "daemon off;"]